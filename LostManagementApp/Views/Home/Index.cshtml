@model IEnumerable<LostManagementApp.Models.Lost>
@{
    var search = ViewData["SearchModel"] as LostManagementApp.Models.LostDto ?? new LostManagementApp.Models.LostDto();
    var insertModel = ViewData["InsertModel"] as LostManagementApp.ViewModels.LostViewModel;
    var searchMessage = ViewData["SearchMessage"] as string;
}

<h2>紛失物一覧／検索</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
}

@if (!string.IsNullOrEmpty(insertModel?.Message))
{
    <div class="alert alert-danger">@insertModel.Message</div>
}

@if (!string.IsNullOrEmpty(searchMessage))
{
    <div class="alert alert-danger">@searchMessage</div>
}

<!-- 検索フォーム（C# サーバーサイドで処理） -->
<form action="@Url.Action("Index", "Home")" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    
    <div>
        <label>ユーザーID</label>
        @Html.ValidationMessageFor(model => search.UserId, "", new { @class = "text-danger" })
        <input type="number" name="UserId" value="@(search.UserId)" class="form-control" />
    </div>
    <div>
        <label>なくした日</label>
        @Html.ValidationMessageFor(model => search.LostDate, "", new { @class = "text-danger" })
        <input type="date" name="LostDate" value="@(search.LostDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div>
        <label>発見日</label>
        @Html.ValidationMessageFor(model => search.FoundDate, "", new { @class = "text-danger" })
        <input type="date" name="FoundDate" value="@(search.FoundDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div>
        <label>なくしたもの</label>
        @Html.ValidationMessageFor(model => search.LostItem, "", new { @class = "text-danger" })
        <input type="text" name="LostItem" value="@(search.LostItem ?? "")" class="form-control" />
    </div>
    <div>
        <label>なくした場所</label>
        @Html.ValidationMessageFor(model => search.LostPlace, "", new { @class = "text-danger" })
        <input type="text" name="LostPlace" value="@(search.LostPlace ?? "")" class="form-control" />
    </div>
    <div>
        <label>詳細な場所</label>
        @Html.ValidationMessageFor(model => search.LostDetailedPlace, "", new { @class = "text-danger" })
        <input type="text" name="LostDetailedPlace" value="@(search.LostDetailedPlace ?? "")" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">検索</button>
    <!-- a asp-action="GetInsert" class="btn btn-success mt-2"-->
    <button type="submit" formaction="@Url.Action("Insert", "Home")" class="btn btn-success mt-2">新規登録</button>
</form>

<!-- 検索結果テーブル + 複数削除フォーム -->
<form asp-action="DeleteSelected" method="post">
    @Html.AntiForgeryToken()
    <table class="table table-striped">
        <thead>
            <tr>
                <th></th>
                <th>紛失ID</th>
                <th>詳細</th>
                <th>紛失日</th>
                <th>発見日</th>
                <th>なくしたもの</th>
                <th>なくした場所</th>
                <th>詳細な場所</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" name="selectedIds" value="@item.LostId" />
                    </td>
                    <td>@item.LostId</td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@item.LostId">●</a>
                    </td>
                    <td>@(item.LostDate?.ToString("yyyy-MM-dd") ?? "")</td>
                    <td>@(item.FoundDate?.ToString("yyyy-MM-dd") ?? "")</td>
                    <td>@item.LostItem</td>
                    <td>@item.LostPlace</td>
                    <td>@item.LostDetailedPlace</td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-danger">選択削除</button>
</form>